{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEZ release component matrix",
  "type": "object",
  "required": ["schema_version", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "component",
          "source_kind",
          "source_attribute_or_command",
          "systems",
          "variant",
          "filename_template",
          "package",
          "direct",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "category": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "source_kind": {"type": "string", "minLength": 1},
          "source_attribute_or_command": {"type": "string", "minLength": 1},
          "systems": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "variant": {"type": "string", "minLength": 1},
          "filename_template": {"type": "string", "minLength": 1},
          "package": {"type": ["string", "null"]},
          "direct": {"type": "boolean"},
          "required": {"type": "boolean"}
        }
      }
    }
  }
}
